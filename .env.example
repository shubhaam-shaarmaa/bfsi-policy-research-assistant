# ==============================================================================
# BFSI Policy Research Assistant - Environment Configuration
# Copy this file to .env and populate credentials. NEVER commit .env to git.
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME="BFSI Policy Research Assistant"
LOG_LEVEL=INFO

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic

# LLM Providers (Stage 5 onwards)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.0

# Embedding Provider (Stage 3 onwards)
# Options: local (sentence-transformers/all-MiniLM-L6-v2), voyage, openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector Database (Stage 3 onwards)
# Options: qdrant, chromadb
VECTOR_DB_PROVIDER=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=data/vectorstore/qdrant_embedded  # Embedded local mode fallback
COLLECTION_NAME=bfsi_policy_circulars

# Retrieval & Reranker (Stage 4 onwards)
RETRIEVAL_HYBRID_ENABLED=true
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
